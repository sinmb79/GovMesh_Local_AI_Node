# GovMesh Local AI Node sample environment.
# Do not put real secrets, certificates, personal information, or government data here.

GOVMESH_ENV=local
GOVMESH_BIND_HOST=127.0.0.1
GOVMESH_BIND_PORT=8787
GOVMESH_STORAGE_DIR=.govmesh-local
GOVMESH_EXTERNAL_NETWORK=disabled

# Required when running the API servers directly.
# Use long random values. Do not commit real tokens.
GOVMESH_API_TOKEN=replace-with-local-dev-token
GOVMESH_AGENT_TOKEN=replace-with-agent-token
GOVMESH_OPERATOR_TOKEN=replace-with-operator-token
GOVMESH_AUDITOR_TOKEN=replace-with-auditor-token
GOVMESH_IMPORTER_TOKEN=replace-with-importer-token
GOVMESH_APPROVER_TOKEN=replace-with-approver-token
GOVMESH_AUDIT_SIGNING_KEY=replace-with-audit-signing-key
